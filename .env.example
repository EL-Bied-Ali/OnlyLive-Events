# Copy to .env and fill in real values. Never commit .env.

# Primary Postgres connection (source of truth). Local dev default matches
# the local postgres-16 apt service started via `sudo service postgresql start`.
DATABASE_URL="postgresql://onlylive:onlylive@localhost:5432/onlylive_dev"

# Separate database used only by the Vitest integration test suite, so tests
# never run against dev data.
TEST_DATABASE_URL="postgresql://onlylive:onlylive@localhost:5432/onlylive_test"

# Dedicated LOCAL Playwright database. `npm run test:e2e` destructively resets
# this database before every browser run. The safety guard only accepts
# localhost/loopback, requires an explicit `e2e` segment in the database name,
# rejects connection-string query parameters, and refuses DATABASE_URL or
# TEST_DATABASE_URL. Never point this at dev/staging/production data.
# Important residual limitation: a localhost URL can still reach a remote DB
# through an SSH tunnel/local proxy. Never run e2e while localhost's Postgres
# port is forwarded to staging/production or another non-disposable database.
E2E_DATABASE_URL="postgresql://onlylive:onlylive@localhost:5432/onlylive_e2e"

# Optional dedicated browser-test port. Playwright deliberately starts its
# own Next.js server and never reuses a developer's existing dev server.
# PLAYWRIGHT_PORT="3100"

# Auth.js (next-auth v4) — customer sessions. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
# Also this deployment's own public base URL — reused by lib/appUrl.ts to
# build absolute links in transactional emails. Must be https in
# production except for a local-loopback host (see lib/appUrl.ts).
NEXTAUTH_URL="http://localhost:3000"

# Admin/scanner custom session signing secret. Generate the same way.
ADMIN_SESSION_SECRET="replace-with-a-random-32-byte-base64-secret"

# Payment provider selection. Only "fake" is implemented so far.
PAYMENT_PROVIDER="fake"

# PAYMENT_PROVIDER=fake is refused at startup whenever NODE_ENV=production,
# unless this is explicitly set to "true". Only for a deliberate
# non-production-traffic staging deployment — never for real customer
# traffic. Leave unset/false in real production.
ALLOW_FAKE_PAYMENTS_IN_PRODUCTION="false"

# HMAC secret used to sign/verify the fake provider's simulated webhook
# callbacks. Generate the same way. A real PSP's own signing secret will
# replace this when a provider is selected.
FAKE_PSP_WEBHOOK_SECRET="replace-with-a-random-32-byte-base64-secret"

# Shared secret the sweep-expired-holds cron trigger must send as the
# X-Internal-Secret header. Generate the same way.
INTERNAL_API_SECRET="replace-with-a-random-32-byte-base64-secret"

# Vercel Cron signing secret (alternative to INTERNAL_API_SECRET above for
# the same housekeeping endpoints). Vercel sends this automatically as
# Authorization: Bearer <CRON_SECRET>. Use at least 16 random characters;
# never commit the real value.
# CRON_SECRET="replace-with-a-random-32-byte-base64-secret"

# Email provider selection. Use "console" for local/test environments;
# "resend" is the real transactional adapter. instrumentation.ts validates
# its required config at boot before customer traffic is accepted.
# EMAIL_PROVIDER="console"
# Required when EMAIL_PROVIDER=resend. Never commit the real API key.
# RESEND_API_KEY="re_xxxxxxxxx"
# Plain sender address only (no display name / angle brackets). The adapter
# formats the outgoing From header as "OnlyLive <address>" itself. For real
# delivery, use a domain verified in Resend.
# RESEND_FROM_EMAIL="tickets@onlylive.ma"
# Optional Preview-only safety redirect: when set, every transactional email
# is delivered to this single inbox instead of the order/admin recipient.
# Refused when VERCEL_ENV=production. Do not commit a real personal address.
# RESEND_TEST_RECIPIENT="your-resend-account@example.com"

# Emergency bypass for an isolated non-customer test deployment only —
# "console" is refused in production otherwise (see lib/email/index.ts).
# Normal local, CI, staging, and production environments never need this;
# never set it for real customer traffic.
# ALLOW_CONSOLE_EMAIL_IN_PRODUCTION="false"

# Optional: how many due EmailOutbox rows lib/email/dispatcher.ts claims per
# invocation of /api/internal/dispatch-emails. Defaults to 20. The Vitest
# integration suite raises this in tests/setup.ts so a test's own row is
# never crowded out of a batch by the shared test database's backlog from
# unrelated tests — production deployments should rarely need to change it.
# EMAIL_DISPATCH_BATCH_SIZE="20"

# Emergency bypass for an isolated non-customer test deployment only.
# Normal local, CI, staging, and production environments should keep the
# limiter enabled so their real HTTP authentication paths remain covered.
# RATE_LIMITING_DISABLED="false"

# HMAC key used to pseudonymize rate-limit identities (IP/email) before
# they are persisted. Required in production; generate 32+ random bytes.
RATE_LIMIT_KEY_SECRET="replace-with-a-random-32-byte-base64-secret"

# Explicit escape hatch only for isolated production-mode browser tests.
# Real customer deployments must leave this false/unset.
# ALLOW_RATE_LIMITING_DISABLED_IN_PRODUCTION="false"

# Optional: only used by `npm run seed`. Both must be set together to
# seed an initial super_admin account — otherwise seeding skips admin
# creation entirely (no default admin is ever created silently). Password
# must be 16+ characters. See docs/SECURITY.md for the bootstrap and
# rotation procedure. Never commit real values here.
# ADMIN_SEED_EMAIL="admin@onlylive.ma"
# ADMIN_SEED_PASSWORD="replace-with-a-strong-unique-password"
