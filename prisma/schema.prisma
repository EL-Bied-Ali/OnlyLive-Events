generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Auth (customers) — Auth.js v4 Prisma adapter shape + our own fields.
// Emails are always normalized to lowercase in application code before
// being written or queried, so a plain unique index is sufficient without
// depending on the citext Postgres extension.
// ─────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  name            String?
  phone           String?
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions            Session[]
  accounts            Account[]
  reservations        Reservation[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// Never stores the raw reset token, only a SHA-256 hash of it -- the raw
/// value exists only transiently in the request handler and the email it
/// sends, exactly like a password itself. usedAt makes every token
/// single-use; a token is valid only when usedAt is null and expiresAt is
/// still in the future.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Admin / staff — deliberately separate from customer auth (own table, own
// session mechanism, own cookie). A bug in the customer-facing auth stack
// can never escalate into admin or scanner access.
// ─────────────────────────────────────────────────────────────────────────

enum AdminRole {
  super_admin
  admin
  scanner
  support
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  role         AdminRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions      AdminSession[]
  createdEvents Event[]        @relation("EventCreatedBy")
  ticketScans   TicketScan[]
  refunds       Refund[]

  @@map("admin_users")
}

model AdminSession {
  id               String   @id @default(uuid())
  adminUserId      String   @map("admin_user_id")
  sessionTokenHash String   @unique @map("session_token_hash")
  expiresAt        DateTime @map("expires_at")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  createdAt        DateTime @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

// ─────────────────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────────────────

model Venue {
  id           String   @id @default(uuid())
  name         String
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  country      String   @default("MA")
  lat          Decimal? @db.Decimal(9, 6)
  lng          Decimal? @db.Decimal(9, 6)
  capacity     Int?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  events Event[]

  @@map("venues")
}

enum EventStatus {
  draft
  published
  on_sale
  sold_out
  closed
  cancelled
}

model Event {
  id                String      @id @default(uuid())
  slug              String      @unique
  title             String
  description       String      @db.Text
  venueId           String      @map("venue_id")
  startsAt          DateTime    @map("starts_at")
  doorsOpenAt       DateTime?   @map("doors_open_at")
  salesOpenAt       DateTime    @map("sales_open_at")
  salesCloseAt      DateTime    @map("sales_close_at")
  maxTicketsPerUser Int         @default(10) @map("max_tickets_per_user")
  status            EventStatus @default(draft)
  coverImageUrl     String?     @map("cover_image_url")
  createdById       String?     @map("created_by")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  venue           Venue            @relation(fields: [venueId], references: [id])
  createdBy       AdminUser?       @relation("EventCreatedBy", fields: [createdById], references: [id])
  ticketCategories TicketCategory[]
  orders          Order[]
  tickets         Ticket[]
  ticketScans     TicketScan[]

  @@index([status])
  @@index([startsAt])
  @@map("events")
}

model TicketCategory {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  event        Event         @relation(fields: [eventId], references: [id])
  salesPhases  SalesPhase[]
  inventory    Inventory?
  reservations Reservation[]
  orderItems   OrderItem[]
  tickets      Ticket[]

  @@unique([eventId, name])
  @@map("ticket_categories")
}

model SalesPhase {
  id                  String   @id @default(uuid())
  ticketCategoryId    String   @map("ticket_category_id")
  name                String
  priceCents          Int      @map("price_cents")
  currency            String   @default("MAD")
  startsAt            DateTime @map("starts_at")
  endsAt              DateTime? @map("ends_at")
  phaseQuantityLimit  Int?     @map("phase_quantity_limit")
  sortOrder           Int      @default(0) @map("sort_order")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  ticketCategory TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  reservations   Reservation[]
  orderItems     OrderItem[]

  @@index([ticketCategoryId, isActive])
  @@map("sales_phases")
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory — the single source of truth for oversell prevention.
// One row per TicketCategory. All mutation goes through lib/inventory.ts,
// which locks this row with SELECT ... FOR UPDATE before reading it.
// The CHECK constraint is defense in depth, not the primary mechanism.
// ─────────────────────────────────────────────────────────────────────────

model Inventory {
  id               String   @id @default(uuid())
  ticketCategoryId String   @unique @map("ticket_category_id")
  totalQuantity    Int      @map("total_quantity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  soldQuantity     Int      @default(0) @map("sold_quantity")
  updatedAt        DateTime @updatedAt @map("updated_at")

  ticketCategory TicketCategory @relation(fields: [ticketCategoryId], references: [id])

  @@map("inventory")
}

enum ReservationStatus {
  active
  converted
  expired
  cancelled
}

model Reservation {
  id               String            @id @default(uuid())
  ticketCategoryId String            @map("ticket_category_id")
  salesPhaseId     String            @map("sales_phase_id")
  userId           String            @map("user_id")
  quantity         Int
  unitPriceCents   Int               @map("unit_price_cents")
  status           ReservationStatus @default(active)
  expiresAt        DateTime          @map("expires_at")
  orderId          String?           @map("order_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  ticketCategory TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  salesPhase     SalesPhase     @relation(fields: [salesPhaseId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  order          Order?         @relation(fields: [orderId], references: [id])
  orderItems     OrderItem[]

  @@index([ticketCategoryId, status, expiresAt])
  @@index([userId, status])
  @@index([salesPhaseId, status])
  @@map("reservations")
}

// ─────────────────────────────────────────────────────────────────────────
// Orders / payments
// ─────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  pending_payment
  paid
  failed
  cancelled
  refunded
  partially_refunded
  paid_but_unfulfillable
  /// A payment.succeeded event arrived for an order already marked
  /// failed/cancelled, and inventory could not be safely re-fulfilled.
  /// The Payment is "paid" (money was captured) but the Order needs a
  /// human to reconcile/refund — see docs/PAYMENTS.md. Not reachable
  /// automatically from any other state.
  reconciliation_required
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  userId          String      @map("user_id")
  eventId         String      @map("event_id")
  status          OrderStatus @default(pending_payment)
  currency        String      @default("MAD")
  totalAmountCents Int        @map("total_amount_cents")
  expiresAt       DateTime?   @map("expires_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  event        Event         @relation(fields: [eventId], references: [id])
  items        OrderItem[]
  reservations Reservation[]
  payments     Payment[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String   @map("order_id")
  ticketCategoryId String   @map("ticket_category_id")
  salesPhaseId     String   @map("sales_phase_id")
  reservationId    String?  @unique @map("reservation_id")
  quantity         Int
  unitPriceCents   Int      @map("unit_price_cents")
  createdAt        DateTime @default(now()) @map("created_at")

  order          Order          @relation(fields: [orderId], references: [id])
  ticketCategory TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  salesPhase     SalesPhase     @relation(fields: [salesPhaseId], references: [id])
  reservation    Reservation?   @relation(fields: [reservationId], references: [id])
  tickets        Ticket[]

  @@index([orderId])
  @@map("order_items")
}

enum PaymentStatus {
  pending
  awaiting_payment
  paid
  failed
  cancelled
  refunded
  partially_refunded
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @map("order_id")
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  redirectUrl       String?       @map("redirect_url")
  /// Claim marker for "a caller is currently calling
  /// provider.createPayment for this payment". Set by the caller that
  /// wins the atomic claim (see lib/orders/checkout.ts), cleared once
  /// providerPaymentId/redirectUrl are stored or the attempt fails. A
  /// stale claim (older than the recovery window) can be reclaimed by a
  /// new caller, so a crashed/timed-out claimant never blocks retries
  /// forever.
  providerInitAt    DateTime?     @map("provider_init_at")
  status            PaymentStatus @default(pending)
  amountCents       Int           @map("amount_cents")
  currency          String        @default("MAD")
  idempotencyKey    String        @unique @map("idempotency_key")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order         Order          @relation(fields: [orderId], references: [id])
  paymentEvents PaymentEvent[]
  refunds       Refund[]

  @@index([orderId])
  @@unique([provider, providerPaymentId])
  @@map("payments")
}

model PaymentEvent {
  id               String    @id @default(uuid())
  paymentId        String    @map("payment_id")
  provider         String
  externalEventId  String    @map("external_event_id")
  eventType        String    @map("event_type")
  rawPayload       Json      @map("raw_payload")
  signatureValid   Boolean   @map("signature_valid")
  processedAt      DateTime? @map("processed_at")
  receivedAt       DateTime  @default(now()) @map("received_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@map("payment_events")
}

// ─────────────────────────────────────────────────────────────────────────
// Tickets / scanning
// ─────────────────────────────────────────────────────────────────────────

enum TicketStatus {
  valid
  used
  cancelled
}

model Ticket {
  id               String       @id @default(uuid())
  orderItemId      String       @map("order_item_id")
  eventId          String       @map("event_id")
  ticketCategoryId String       @map("ticket_category_id")
  validationToken  String       @unique @map("validation_token")
  status           TicketStatus @default(valid)
  attendeeName     String?      @map("attendee_name")
  attendeeEmail    String?      @map("attendee_email")
  createdAt        DateTime     @default(now()) @map("created_at")
  usedAt           DateTime?    @map("used_at")

  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id])
  event          Event          @relation(fields: [eventId], references: [id])
  ticketCategory TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  scans          TicketScan[]

  @@index([orderItemId])
  @@index([eventId, status])
  @@map("tickets")
}

enum ScanResult {
  valid
  already_used
  invalid
  cancelled
  wrong_event
}

// Schema only this session — no scanner UI yet, but future work shouldn't
// require a migration to add check-in tracking.
model TicketScan {
  id                 String     @id @default(uuid())
  ticketId           String?    @map("ticket_id")
  scannedToken       String     @map("scanned_token")
  scannerAdminUserId String     @map("scanner_admin_user_id")
  eventId            String     @map("event_id")
  result             ScanResult
  scannedAt          DateTime   @default(now()) @map("scanned_at")

  ticket           Ticket?   @relation(fields: [ticketId], references: [id])
  scannerAdminUser AdminUser @relation(fields: [scannerAdminUserId], references: [id])
  event            Event     @relation(fields: [eventId], references: [id])

  @@index([ticketId])
  @@index([eventId])
  @@map("ticket_scans")
}

enum RefundStatus {
  pending
  processing
  succeeded
  failed
}

model Refund {
  id                     String       @id @default(uuid())
  paymentId              String       @map("payment_id")
  amountCents            Int          @map("amount_cents")
  reason                 String
  status                 RefundStatus @default(pending)
  initiatedByAdminUserId String       @map("initiated_by_admin_user_id")
  providerRefundId       String?      @map("provider_refund_id")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  payment              Payment   @relation(fields: [paymentId], references: [id])
  initiatedByAdminUser AdminUser @relation(fields: [initiatedByAdminUserId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit log
// ─────────────────────────────────────────────────────────────────────────

enum AuditActorType {
  admin
  system
  customer
}

model AuditLog {
  id         String         @id @default(uuid())
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id")
  action     String
  entityType String         @map("entity_type")
  entityId   String         @map("entity_id")
  metadata   Json?
  ipAddress  String?        @map("ip_address")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Transactional email — durable outbox
// ─────────────────────────────────────────────────────────────────────────

enum EmailType {
  order_confirmation
  payment_failed
  refund_confirmation
  reconciliation_alert
}

enum EmailOutboxStatus {
  pending
  processing
  sent
  failed
}

/// Transactional outbox, not a send log. A row is enqueued inside the SAME
/// database transaction that confirms the underlying business fact
/// (payment success + ticket generation, a failed/cancelled payment, or a
/// succeeded refund) — see lib/email/notifications.ts's enqueue* functions
/// and their callers in the payment webhook route and lib/orders/refund.ts.
/// Actual delivery happens later, out-of-band, via
/// lib/email/dispatcher.ts::dispatchPendingEmails, so a crash between the
/// business transaction committing and the email being sent leaves a
/// durable `pending` row instead of silently losing the notification.
/// `status` moves pending -> processing -> sent, or back to pending with a
/// backed-off `nextAttemptAt` on a retryable failure, or to `failed` once
/// `attemptCount` exhausts the dispatcher's retry budget.
///
/// The unique (type, entityType, entityId) constraint is the same
/// idempotent-insert idiom as PaymentEvent's (provider, externalEventId):
/// a retriggering caller (e.g. the same business transition reached again)
/// is a safe no-op — it can never enqueue a second job for the same
/// logical notification. Eligibility to actually send is re-checked
/// against live state at dispatch time (see the dispatcher), never assumed
/// from the fact that a row exists.
model EmailOutbox {
  id                  String            @id @default(uuid())
  type                EmailType
  entityType          String            @map("entity_type")
  entityId            String            @map("entity_id")
  recipientEmail      String            @map("recipient_email")
  status              EmailOutboxStatus @default(pending)
  attemptCount        Int               @default(0) @map("attempt_count")
  nextAttemptAt       DateTime          @default(now()) @map("next_attempt_at")
  processingStartedAt DateTime?         @map("processing_started_at")
  sentAt              DateTime?         @map("sent_at")
  lastErrorCode       String?           @map("last_error_code")
  providerMessageId   String?           @map("provider_message_id")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@unique([type, entityType, entityId])
  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

// ─────────────────────────────────────────────────────────────────────────
// Rate limiting
// ─────────────────────────────────────────────────────────────────────────

/// Fixed-window counter keyed by an action scope plus an HMAC of the IP or
/// normalized account/email; raw identities are never persisted. No Redis/
/// external cache exists in this app, so Postgres is the shared store across
/// concurrent serverless instances. Buckets are pruned after 48 hours by the
/// authenticated housekeeping endpoint. See lib/rateLimit.ts.
model RateLimitBucket {
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}
